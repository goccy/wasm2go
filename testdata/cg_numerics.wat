;; cg_numerics.wat — exercises a broad spread of numeric opcodes the legacy
;; fncompiler must handle: i64/f32/f64 constants, select, popcnt/clz/ctz,
;; rotate, the full comparison family, and int/float conversions. Used to
;; light up decoder.go (readS64/readF32/readF64) and fncompiler helpers.
(module
  (func (export "i64const") (result i64)
    (i64.const -1234567890123456789))
  (func (export "f32const") (result f32)
    (f32.const 3.14159))
  (func (export "f64const") (result f64)
    (f64.const 2.718281828459045))
  (func (export "sel") (param i32 i32 i32) (result i32)
    (select (local.get 0) (local.get 1) (local.get 2)))
  (func (export "popcnt") (param i32) (result i32)
    (i32.popcnt (local.get 0)))
  (func (export "clz") (param i32) (result i32)
    (i32.clz (local.get 0)))
  (func (export "ctz") (param i32) (result i32)
    (i32.ctz (local.get 0)))
  (func (export "popcnt64") (param i64) (result i64)
    (i64.popcnt (local.get 0)))
  (func (export "rotl") (param i32 i32) (result i32)
    (i32.rotl (local.get 0) (local.get 1)))
  (func (export "rotr") (param i32 i32) (result i32)
    (i32.rotr (local.get 0) (local.get 1)))
  (func (export "eqz") (param i32) (result i32)
    (i32.eqz (local.get 0)))
  (func (export "cmp_eq") (param i32 i32) (result i32)
    (i32.eq (local.get 0) (local.get 1)))
  (func (export "cmp_ne") (param i32 i32) (result i32)
    (i32.ne (local.get 0) (local.get 1)))
  (func (export "cmp_le_s") (param i32 i32) (result i32)
    (i32.le_s (local.get 0) (local.get 1)))
  (func (export "cmp_ge_u") (param i32 i32) (result i32)
    (i32.ge_u (local.get 0) (local.get 1)))
  (func (export "fadd") (param f64 f64) (result f64)
    (f64.add (local.get 0) (local.get 1)))
  (func (export "fmul") (param f32 f32) (result f32)
    (f32.mul (local.get 0) (local.get 1)))
  (func (export "fmin") (param f64 f64) (result f64)
    (f64.min (local.get 0) (local.get 1)))
  (func (export "fmax") (param f64 f64) (result f64)
    (f64.max (local.get 0) (local.get 1)))
  (func (export "fabs") (param f64) (result f64)
    (f64.abs (local.get 0)))
  (func (export "fsqrt") (param f64) (result f64)
    (f64.sqrt (local.get 0)))
  (func (export "fneg") (param f32) (result f32)
    (f32.neg (local.get 0)))
  (func (export "fceil") (param f64) (result f64)
    (f64.ceil (local.get 0)))
  (func (export "ffloor") (param f64) (result f64)
    (f64.floor (local.get 0)))
  (func (export "i32_to_f64") (param i32) (result f64)
    (f64.convert_i32_s (local.get 0)))
  (func (export "f64_to_i32") (param f64) (result i32)
    (i32.trunc_f64_s (local.get 0)))
  (func (export "i32_to_i64_u") (param i32) (result i64)
    (i64.extend_i32_u (local.get 0)))
  (func (export "i64_to_i32") (param i64) (result i32)
    (i32.wrap_i64 (local.get 0)))
  (func (export "f32_to_f64") (param f32) (result f64)
    (f64.promote_f32 (local.get 0)))
  (func (export "f64_to_f32") (param f64) (result f32)
    (f32.demote_f64 (local.get 0)))
  (func (export "fcmp_lt") (param f64 f64) (result i32)
    (f64.lt (local.get 0) (local.get 1)))
  (func (export "i64_shifts") (param i64 i64) (result i64)
    (i64.shr_u (i64.shl (local.get 0) (local.get 1)) (local.get 1)))
  (func (export "reinterp") (param f32) (result i32)
    (i32.reinterpret_f32 (local.get 0)))
)
